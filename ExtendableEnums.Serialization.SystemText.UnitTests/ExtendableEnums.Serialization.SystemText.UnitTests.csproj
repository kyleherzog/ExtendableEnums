  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove="C:\Repos\kyleherzog\ExtendableEnums\ExtendableEnums.Serialization.SystemText.UnitTests\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Repos\kyleherzog\ExtendableEnums\ExtendableEnums.Serialization.SystemText.UnitTests\.editorconfig" />
